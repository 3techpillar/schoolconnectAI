# Server environment example
MONGO_URI=mongodb://localhost:27017/schoolconnect
JWT_SECRET=your_super_secret_jwt_key_here
OTP_PROVIDER=demo
PORT=4004
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Email / SMTP Configuration
SMTP_HOST="smtp.your-provider.com"  # e.g., smtp.sendgrid.net or smtp.resend.com
SMTP_PORT="587"                     # Usually 587 (TLS) or 465 (SSL)
SMTP_USER="your-smtp-username"      # E.g., "apikey" or your email address
SMTP_PASS="your-smtp-password"      # E.g., your actual API key
