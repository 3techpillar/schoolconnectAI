# Environment variables for SchoolConnect AI
# Copy the file for your target environment, then adjust values:
#   cp .env.development .env.local          # local overrides
#   cp .env.staging .env.local              # run/build as staging locally
#   cp .env.production .env.local           # rare — prefer host env vars in prod

# App
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=SchoolConnect AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo auth (client-visible — never put real secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_DEMO_OTP=000000
NEXT_PUBLIC_DEMO_MODE=true

# Optional analytics / monitoring hooks (unused by default)
# NEXT_PUBLIC_ANALYTICS_ID=
