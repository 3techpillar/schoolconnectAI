# Environment variables for SchoolConnect AI
# Copy the file for your target environment, then adjust values:
#   cp .env.development .env.local          # local overrides
#   cp .env.staging .env.local              # run/build as staging locally
#   cp .env.production .env.local           # rare — prefer host env vars in prod

# App
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=SchoolConnect AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo auth (client-visible — never put real secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_DEMO_OTP=000000
NEXT_PUBLIC_DEMO_MODE=true

# MongoDB + server auth (server-only — never use NEXT_PUBLIC_*)
# When MONGODB_URI or MONGO_URI is set, /api/health reports mongo:true and the app uses APIs.
MONGODB_URI=mongodb://127.0.0.1:27017/schoolconnect
# MONGO_URI=mongodb://127.0.0.1:27017/schoolconnect

# REQUIRED for JWT sessions + OTP hashing (min 16 chars). Never reuse the Mongo URI.
JWT_SECRET=change-me-to-a-long-random-string

OTP_PROVIDER=demo
# OTP_DEMO_CODE=000000
# Set NEXT_PUBLIC_DEMO_MODE=false in production so the UI does not show the demo OTP.

# Optional analytics / monitoring hooks (unused by default)
# NEXT_PUBLIC_ANALYTICS_ID=
