{
  "name": "schoolconnect",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "APP_ENV=staging NEXT_PUBLIC_APP_ENV=staging next dev -p 3001",
    "build": "next build",
    "build:staging": "APP_ENV=staging NEXT_PUBLIC_APP_ENV=staging next build",
    "build:production": "APP_ENV=production NEXT_PUBLIC_APP_ENV=production next build",
    "start": "next start",
    "start:staging": "APP_ENV=staging NEXT_PUBLIC_APP_ENV=staging next start -p 3001",
    "start:production": "APP_ENV=production NEXT_PUBLIC_APP_ENV=production next start -p 3000",
    "docker:build": "docker build -t schoolconnect:local .",
    "docker:run": "docker run --rm -p 3000:3000 schoolconnect:local"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2"
  }
}
